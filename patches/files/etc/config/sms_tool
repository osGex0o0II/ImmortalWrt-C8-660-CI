
config sms_tool 'general'
        option prefix '1'
        option sendport '/dev/ttyUSB2'
        option ussdport '/dev/ttyUSB2'
        option atport '/dev/ttyUSB2'
        option readport '/dev/ttyUSB2'
        option storage 'ME'
        option pnumber '86'
        option information '0'
        option forward_enable '0'
        option forward_interval '30'
        option forward_complete_only '1'
        option forward_delete_after '0'
        option forward_primary_channel 'ops_pushplus'
        option forward_backup_enable '0'
        option forward_backup_channel 'backup_telegram'
        option forward_retry_count '1'
        option forward_retry_delay '3'
        option forward_proxy ''

config forward_channel 'ops_pushplus'
        option name '运维 PushPlus'
        option type 'pushplus'
        option enabled '0'
        option remark '主用通道'
        option token ''

config forward_channel 'backup_telegram'
        option name '备用 Telegram'
        option type 'telegram'
        option enabled '0'
        option remark '备用通道'
        option api_server 'https://api.telegram.org'
        option bot_token ''
        option chat_id ''
        option thread_id ''
