#!/bin/sh

awk -v rsrp="${1:-}" -v bw="${2:-}" '
function valid_number(v) {
	return v ~ /^-?[0-9]+([.][0-9]+)?$/;
}
function floor_number(v, i) {
	i = int(v);
	return (v < i) ? i - 1 : i;
}
BEGIN {
	if (!valid_number(rsrp)) {
		print -113;
		exit;
	}
	if (!valid_number(bw))
		bw = 20;
	n = (bw == 1.4) ? 6 : bw * 5;
	if (n <= 0)
		n = 100;
	rssi = rsrp + (10 * log(n * 12) / log(10));
	if (rssi < -113)
		rssi = -113;
	else if (rssi > -51)
		rssi = -51;
	printf "%d\n", floor_number(rssi);
}
'
