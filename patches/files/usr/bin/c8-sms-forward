#!/bin/sh

STATE_DIR="/tmp/c8-sms-forward"
STATE_FILE="$STATE_DIR/sent.keys"
PENDING_FILE="$STATE_DIR/pending.json"
LOG_FILE="/tmp/c8-sms-forward.log"
SMS_TOOL_BIN="${SMS_TOOL_BIN:-/usr/bin/sms_tool}"

log_msg() {
	mkdir -p "$STATE_DIR"
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

uci_get() {
	uci -q get "$1" 2>/dev/null || printf '%s' "${2:-}"
}

uci_first() {
	local default="$1" key value

	shift
	for key in "$@"; do
		value="$(uci -q get "$key" 2>/dev/null)"
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
	done
	printf '%s' "$default"
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

channel_sections() {
	uci -q show sms_tool | sed -n 's/^sms_tool\.\([^.=]*\)=forward_channel$/\1/p'
}

sms_cfg() {
	local legacy_channel

	STORAGE="$(uci_get sms_tool.general.storage ME)"
	PORT="$(uci_get sms_tool.general.readport /dev/ttyUSB2)"
	FORWARD_ENABLE="$(uci_get sms_tool.general.forward_enable 0)"
	FORWARD_COMPLETE_ONLY="$(uci_get sms_tool.general.forward_complete_only 1)"
	FORWARD_DELETE_AFTER="$(uci_get sms_tool.general.forward_delete_after 0)"
	FORWARD_PRIMARY_CHANNEL="$(uci_get sms_tool.general.forward_primary_channel ops_pushplus)"
	FORWARD_BACKUP_ENABLE="$(uci_get sms_tool.general.forward_backup_enable 0)"
	FORWARD_BACKUP_CHANNEL="$(uci_get sms_tool.general.forward_backup_channel backup_telegram)"
	FORWARD_RETRY_COUNT="$(uci_get sms_tool.general.forward_retry_count 1)"
	FORWARD_RETRY_DELAY="$(uci_get sms_tool.general.forward_retry_delay 3)"
	SMS_TOOL_TIMEOUT="$(uci_get sms_tool.general.sms_tool_timeout 20)"

	legacy_channel="$(uci_get sms_tool.general.forward_channel '')"
	case "$legacy_channel" in
		serverchan|serverchan3|pushplus|telegram|wxpusher|qywx|diy)
			FORWARD_PRIMARY_CHANNEL="$legacy_channel"
		;;
	esac

	case "$FORWARD_PRIMARY_CHANNEL" in
		pushplus) FORWARD_PRIMARY_CHANNEL="ops_pushplus" ;;
		telegram) FORWARD_PRIMARY_CHANNEL="backup_telegram" ;;
	esac
	case "$FORWARD_BACKUP_CHANNEL" in
		pushplus) FORWARD_BACKUP_CHANNEL="ops_pushplus" ;;
		telegram) FORWARD_BACKUP_CHANNEL="backup_telegram" ;;
	esac
	case "$SMS_TOOL_TIMEOUT" in
		''|*[!0-9]*) SMS_TOOL_TIMEOUT=20 ;;
	esac
	[ "$SMS_TOOL_TIMEOUT" -ge 5 ] || SMS_TOOL_TIMEOUT=5
	[ "$SMS_TOOL_TIMEOUT" -le 120 ] || SMS_TOOL_TIMEOUT=120
}

require_cmd() {
	command -v "$1" >/dev/null 2>&1 || {
		log_msg "ERROR missing command: $1"
		return 1
	}
}

missing_runtime_deps() {
	local missing dep

	for dep in jq curl "$SMS_TOOL_BIN"; do
		command -v "$dep" >/dev/null 2>&1 || missing="${missing}${missing:+ }$dep"
	done
	printf '%s' "$missing"
}

run_sms_tool() {
	local out_file="$1"
	local err_file="$2"
	local pid elapsed

	shift 2
	"$SMS_TOOL_BIN" "$@" > "$out_file" 2> "$err_file" &
	pid="$!"
	elapsed=0

	while kill -0 "$pid" 2>/dev/null; do
		if [ "$elapsed" -ge "$SMS_TOOL_TIMEOUT" ]; then
			kill "$pid" 2>/dev/null || true
			wait "$pid" 2>/dev/null || true
			printf 'sms_tool timed out after %s seconds\n' "$SMS_TOOL_TIMEOUT" > "$err_file"
			log_msg "ERROR sms_tool timeout after ${SMS_TOOL_TIMEOUT}s: $*"
			return 124
		fi
		sleep 1
		elapsed=$((elapsed + 1))
	done

	wait "$pid"
}

trim_state() {
	[ -f "$STATE_FILE" ] || return 0
	tail -n 200 "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

already_sent() {
	[ -n "$1" ] || return 1
	[ -f "$STATE_FILE" ] && grep -Fxq "$1" "$STATE_FILE"
}

mark_sent() {
	[ -n "$1" ] || return 0
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$1" >> "$STATE_FILE"
	trim_state
}

delete_indexes() {
	local indexes="$1" index

	[ "$FORWARD_DELETE_AFTER" = "1" ] || return 0
	printf '%s' "$indexes" | tr ',' '\n' | sort -nr | while read -r index; do
		[ -n "$index" ] || continue
		"$SMS_TOOL_BIN" -s "$STORAGE" -d "$PORT" delete "$index" >/dev/null 2>&1 || \
			log_msg "WARN failed to delete sms index $index"
	done
}

channel_get() {
	local section="$1"
	local option="$2"
	local default="$3"

	uci_get "sms_tool.${section}.${option}" "$default"
}

channel_name() {
	local channel_id="$1"
	local name

	name="$(channel_get "$channel_id" name '')"
	[ -n "$name" ] || name="$channel_id"
	printf '%s' "$name"
}

channel_type() {
	local channel_id="$1"
	local type

	type="$(channel_get "$channel_id" type '')"
	if [ -z "$type" ]; then
		case "$channel_id" in
			serverchan|serverchan3|pushplus|telegram|wxpusher|qywx|diy) type="$channel_id" ;;
		esac
	fi
	printf '%s' "$type"
}

channel_exists() {
	local channel_id="$1"
	local type

	type="$(uci_get "sms_tool.${channel_id}" '')"
	[ "$type" = "forward_channel" ] && return 0
	case "$channel_id" in
		serverchan|serverchan3|pushplus|telegram|wxpusher|qywx|diy) return 0 ;;
	esac
	return 1
}

channel_enabled() {
	local channel_id="$1"
	local enabled

	enabled="$(channel_get "$channel_id" enabled 1)"
	[ "$enabled" = "1" ] || return 1
}

channel_value() {
	local channel_id="$1"
	local option="$2"
	local default="$3"

	uci_first "$default" "sms_tool.${channel_id}.${option}"
}

channel_ready() {
	local channel="$1"
	local type

	channel_exists "$channel" || return 1
	channel_enabled "$channel" || return 1
	type="$(channel_type "$channel")"

	case "$type" in
		serverchan)
			[ -n "$(uci_first '' "sms_tool.${channel}.sckey" sms_tool.general.forward_serverchan_sckey)" ]
		;;
		serverchan3)
			[ -n "$(uci_first '' "sms_tool.${channel}.uid" sms_tool.general.forward_serverchan3_uid)" ] &&
			[ -n "$(uci_first '' "sms_tool.${channel}.sendkey" sms_tool.general.forward_serverchan3_key)" ]
		;;
		pushplus)
			[ -n "$(uci_first '' "sms_tool.${channel}.token" sms_tool.general.forward_pushplus_token)" ]
		;;
		telegram)
			[ -n "$(uci_first '' "sms_tool.${channel}.bot_token" sms_tool.general.forward_tg_token)" ] &&
			[ -n "$(uci_first '' "sms_tool.${channel}.chat_id" sms_tool.general.forward_tg_chat_id)" ]
		;;
		wxpusher)
			[ -n "$(uci_first '' "sms_tool.${channel}.app_token" sms_tool.general.forward_wxpusher_apptoken)" ] &&
			{ [ -n "$(uci_first '' "sms_tool.${channel}.uids" sms_tool.general.forward_wxpusher_uids)" ] ||
				[ -n "$(uci_first '' "sms_tool.${channel}.topic_ids" sms_tool.general.forward_wxpusher_topicids)" ]; }
		;;
		qywx)
			[ -n "$(uci_first '' "sms_tool.${channel}.corpid" sms_tool.general.forward_qywx_corpid)" ] &&
			[ -n "$(uci_first '' "sms_tool.${channel}.corpsecret" sms_tool.general.forward_qywx_corpsecret)" ] &&
			[ -n "$(uci_first '' "sms_tool.${channel}.agentid" sms_tool.general.forward_qywx_agentid)" ]
		;;
		diy)
			[ -n "$(channel_value "$channel" url "$(uci_get sms_tool.general.forward_diy_url '')")" ]
		;;
		*) return 1 ;;
	esac
}

channel_issue() {
	local channel="$1"
	local type missing

	channel_exists "$channel" || { printf '通道不存在'; return 0; }
	channel_enabled "$channel" || { printf '通道已停用'; return 0; }
	type="$(channel_type "$channel")"

	case "$type" in
		serverchan)
			[ -n "$(uci_first '' "sms_tool.${channel}.sckey" sms_tool.general.forward_serverchan_sckey)" ] || \
				missing="${missing}${missing:+、}Server酱 SendKey"
		;;
		serverchan3)
			[ -n "$(uci_first '' "sms_tool.${channel}.uid" sms_tool.general.forward_serverchan3_uid)" ] || \
				missing="${missing}${missing:+、}Server酱3 UID"
			[ -n "$(uci_first '' "sms_tool.${channel}.sendkey" sms_tool.general.forward_serverchan3_key)" ] || \
				missing="${missing}${missing:+、}Server酱3 SendKey"
		;;
		pushplus)
			[ -n "$(uci_first '' "sms_tool.${channel}.token" sms_tool.general.forward_pushplus_token)" ] || \
				missing="${missing}${missing:+、}PushPlus Token"
		;;
		telegram)
			[ -n "$(uci_first '' "sms_tool.${channel}.bot_token" sms_tool.general.forward_tg_token)" ] || \
				missing="${missing}${missing:+、}Telegram Bot Token"
			[ -n "$(uci_first '' "sms_tool.${channel}.chat_id" sms_tool.general.forward_tg_chat_id)" ] || \
				missing="${missing}${missing:+、}Telegram Chat ID"
		;;
		wxpusher)
			[ -n "$(uci_first '' "sms_tool.${channel}.app_token" sms_tool.general.forward_wxpusher_apptoken)" ] || \
				missing="${missing}${missing:+、}WxPusher AppToken"
			{ [ -n "$(uci_first '' "sms_tool.${channel}.uids" sms_tool.general.forward_wxpusher_uids)" ] ||
				[ -n "$(uci_first '' "sms_tool.${channel}.topic_ids" sms_tool.general.forward_wxpusher_topicids)" ]; } || \
				missing="${missing}${missing:+、}WxPusher UID/主题 ID"
		;;
		qywx)
			[ -n "$(uci_first '' "sms_tool.${channel}.corpid" sms_tool.general.forward_qywx_corpid)" ] || \
				missing="${missing}${missing:+、}企业微信 CorpID"
			[ -n "$(uci_first '' "sms_tool.${channel}.corpsecret" sms_tool.general.forward_qywx_corpsecret)" ] || \
				missing="${missing}${missing:+、}企业微信 Secret"
			[ -n "$(uci_first '' "sms_tool.${channel}.agentid" sms_tool.general.forward_qywx_agentid)" ] || \
				missing="${missing}${missing:+、}企业微信 AgentID"
		;;
		diy)
			[ -n "$(channel_value "$channel" url "$(uci_get sms_tool.general.forward_diy_url '')")" ] || \
				missing="${missing}${missing:+、}Webhook 地址"
		;;
		*)
			printf '未知通道类型'
			return 0
		;;
	esac

	if [ -n "$missing" ]; then
		printf '缺少%s' "$missing"
	else
		printf '可用'
	fi
}

forward_cfg() {
	FORWARD_PROXY="$(uci_get sms_tool.general.forward_proxy '')"
}

curl_post() {
	local url="$1"
	shift

	if [ -n "$FORWARD_PROXY" ]; then
		curl -fsS --connect-timeout 20 --max-time 60 --retry 1 -x "$FORWARD_PROXY" "$@" "$url"
	else
		curl -fsS --connect-timeout 20 --max-time 60 --retry 1 "$@" "$url"
	fi
}

push_diy_url() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local payload url

	url="$(channel_value "$channel" url "$(uci_get sms_tool.general.forward_diy_url '')")"
	[ -n "$url" ] || return 1
	payload="$(jq -cn --arg title "$title" --arg content "$content" \
		'{title:$title,content:$content,text:($title + "\n\n" + $content)}')"
	curl_post "$url" -H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_serverchan() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local url sckey

	sckey="$(uci_first '' "sms_tool.${channel}.sckey" sms_tool.general.forward_serverchan_sckey)"
	[ -n "$sckey" ] || return 1
	url="https://sctapi.ftqq.com/${sckey}.send"
	curl_post "$url" \
		--data-urlencode "text=$title" \
		--data-urlencode "desp=$content" >/dev/null
}

push_serverchan3() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local key uid tags payload

	uid="$(uci_first '' "sms_tool.${channel}.uid" sms_tool.general.forward_serverchan3_uid)"
	key="$(uci_first '' "sms_tool.${channel}.sendkey" sms_tool.general.forward_serverchan3_key)"
	tags="$(uci_first '' "sms_tool.${channel}.tags" sms_tool.general.forward_serverchan3_tags)"
	[ -n "$uid" ] && [ -n "$key" ] || return 1
	payload="$(jq -cn --arg title "$title" --arg desp "$content" --arg tags "$tags" \
		'{title:$title,desp:$desp,tags:$tags}')"
	curl_post "https://${uid}.push.ft07.com/send/${key}.send" \
		-H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_pushplus() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local token payload

	token="$(uci_first '' "sms_tool.${channel}.token" sms_tool.general.forward_pushplus_token)"
	[ -n "$token" ] || return 1
	payload="$(jq -cn --arg title "$title" --arg content "$content" --arg token "$token" \
		'{title:$title,content:$content,token:$token,template:"markdown"}')"
	curl_post "http://www.pushplus.plus/send" -H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_telegram() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local api_server token chat_id thread_id payload text

	api_server="$(uci_first 'https://api.telegram.org' "sms_tool.${channel}.api_server" sms_tool.general.forward_tg_api_server)"
	token="$(uci_first '' "sms_tool.${channel}.bot_token" sms_tool.general.forward_tg_token)"
	chat_id="$(uci_first '' "sms_tool.${channel}.chat_id" sms_tool.general.forward_tg_chat_id)"
	thread_id="$(uci_first '' "sms_tool.${channel}.thread_id" sms_tool.general.forward_tg_thread_id)"
	[ -n "$token" ] && [ -n "$chat_id" ] || return 1
	text="<b>${title}</b>\n----\n${content}"
	if [ -n "$thread_id" ]; then
		payload="$(jq -cn --arg text "$text" --arg chat_id "$chat_id" --arg thread_id "$thread_id" \
			'{text:$text,chat_id:$chat_id,message_thread_id:$thread_id,parse_mode:"HTML"}')"
	else
		payload="$(jq -cn --arg text "$text" --arg chat_id "$chat_id" \
			'{text:$text,chat_id:$chat_id,parse_mode:"HTML"}')"
	fi
	curl_post "${api_server}/bot${token}/sendMessage" \
		-H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_wxpusher() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local app_token uids topic_ids payload

	app_token="$(uci_first '' "sms_tool.${channel}.app_token" sms_tool.general.forward_wxpusher_apptoken)"
	uids="$(uci_first '' "sms_tool.${channel}.uids" sms_tool.general.forward_wxpusher_uids)"
	topic_ids="$(uci_first '' "sms_tool.${channel}.topic_ids" sms_tool.general.forward_wxpusher_topicids)"
	[ -n "$app_token" ] || return 1
	[ -n "$uids" ] || [ -n "$topic_ids" ] || return 1
	payload="$(jq -cn \
		--arg summary "$title" \
		--arg content "$content" \
		--arg appToken "$app_token" \
		--arg uids "$uids" \
		--arg topicIds "$topic_ids" \
		'{
			summary:$summary,
			content:$content,
			appToken:$appToken,
			contentType:3,
			uids:($uids | split(" ") | map(select(length > 0))),
			topicIds:($topicIds | split(" ") | map(select(length > 0)))
		}')"
	curl_post "http://wxpusher.zjiecode.com/api/send/message" \
		-H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_qywx() {
	local channel="$1"
	shift
	local title="$1"
	local content="$2"
	local corpid corpsecret agentid userid token payload

	corpid="$(uci_first '' "sms_tool.${channel}.corpid" sms_tool.general.forward_qywx_corpid)"
	corpsecret="$(uci_first '' "sms_tool.${channel}.corpsecret" sms_tool.general.forward_qywx_corpsecret)"
	agentid="$(uci_first '' "sms_tool.${channel}.agentid" sms_tool.general.forward_qywx_agentid)"
	userid="$(uci_first '@all' "sms_tool.${channel}.userid" sms_tool.general.forward_qywx_userid)"
	[ -n "$corpid" ] && [ -n "$corpsecret" ] && [ -n "$agentid" ] || return 1
	[ -n "$userid" ] || userid="@all"
	token="$(curl -fsS --connect-timeout 15 --max-time 30 \
		"https://qyapi.weixin.qq.com/cgi-bin/gettoken?corpid=${corpid}&corpsecret=${corpsecret}" | jq -r '.access_token // empty')"
	[ -n "$token" ] || return 1
	payload="$(jq -cn --arg touser "$userid" --arg agentid "$agentid" --arg content "#### ${title}\n${content}" \
		'{touser:$touser,msgtype:"markdown",agentid:($agentid|tonumber),markdown:{content:$content}}')"
	curl_post "https://qyapi.weixin.qq.com/cgi-bin/message/send?access_token=${token}" \
		-H 'Content-Type: application/json' -d "$payload" >/dev/null
}

push_channel() {
	local channel="$1"
	local title="$2"
	local content="$3"
	local type

	channel_enabled "$channel" || { log_msg "ERROR channel disabled or missing: $channel"; return 1; }
	type="$(channel_type "$channel")"
	case "$type" in
		serverchan) push_serverchan "$channel" "$title" "$content" ;;
		serverchan3) push_serverchan3 "$channel" "$title" "$content" ;;
		pushplus) push_pushplus "$channel" "$title" "$content" ;;
		telegram) push_telegram "$channel" "$title" "$content" ;;
		wxpusher) push_wxpusher "$channel" "$title" "$content" ;;
		qywx) push_qywx "$channel" "$title" "$content" ;;
		diy) push_diy_url "$channel" "$title" "$content" ;;
		*) log_msg "ERROR unknown forward channel type: channel=$channel type=$type"; return 1 ;;
	esac
}

push_with_retry() {
	local role="$1"
	local channel="$2"
	local title="$3"
	local content="$4"
	local attempt=0 retry_count retry_delay

	case "$FORWARD_RETRY_COUNT" in
		''|*[!0-9]*) retry_count=0 ;;
		*) retry_count="$FORWARD_RETRY_COUNT" ;;
	esac
	case "$FORWARD_RETRY_DELAY" in
		''|*[!0-9]*) retry_delay=3 ;;
		*) retry_delay="$FORWARD_RETRY_DELAY" ;;
	esac

	while [ "$attempt" -le "$retry_count" ]; do
		attempt=$((attempt + 1))
		if push_channel "$channel" "$title" "$content"; then
			log_msg "INFO push $role ok channel=$(channel_name "$channel") id=$channel attempt=$attempt"
			return 0
		fi

		log_msg "WARN push $role failed channel=$(channel_name "$channel") id=$channel attempt=$attempt"
		[ "$attempt" -le "$retry_count" ] || break
		[ "$retry_delay" -gt 0 ] && sleep "$retry_delay"
	done

	return 1
}

push_message() {
	local title="$1"
	local content="$2"

	forward_cfg
	if push_with_retry primary "$FORWARD_PRIMARY_CHANNEL" "$title" "$content"; then
		return 0
	fi

	if [ "$FORWARD_BACKUP_ENABLE" = "1" ] && [ -n "$FORWARD_BACKUP_CHANNEL" ] && \
		[ "$FORWARD_BACKUP_CHANNEL" != "$FORWARD_PRIMARY_CHANNEL" ]; then
		log_msg "WARN primary failed, trying backup primary=$(channel_name "$FORWARD_PRIMARY_CHANNEL") backup=$(channel_name "$FORWARD_BACKUP_CHANNEL")"
		if push_with_retry backup "$FORWARD_BACKUP_CHANNEL" "$title" "$content"; then
			return 0
		fi
	fi

	log_msg "ERROR push all failed primary=$(channel_name "$FORWARD_PRIMARY_CHANNEL") backup=$(channel_name "$FORWARD_BACKUP_CHANNEL")"
	return 1
}

read_merged_messages() {
	local raw_file="$1"

	jq -c '
		def indexes(v):
			((v // "") | tostring | [scan("[0-9]+")] | unique_by(tonumber) | sort_by(tonumber));
		def msg_index:
			(.index // .id // .slot // "");
		def norm:
			{
				indexes: indexes(msg_index),
				sender: (.sender // "-"),
				timestamp: (.timestamp // .date // .time // "-"),
				reference: (.reference // .ref // ""),
				part: ((.part // 1) | tonumber),
				total: ((.total // 1) | tonumber),
				content: (.content // .text // .message // "")
			};
		(.msg // .messages // . // []) as $list |
		($list | if type == "array" then . else [] end | map(norm)) as $msgs |
		reduce $msgs[] as $m ({};
			($m.total | if . > 1 then
				[$m.sender, $m.timestamp, $m.reference, tostring] | join("|")
			else
				[$m.sender, $m.timestamp, ($m.indexes | join(","))] | join("|")
			end) as $key |
			.[$key].sender = $m.sender |
			.[$key].timestamp = $m.timestamp |
			.[$key].reference = $m.reference |
			.[$key].parts = ([.[$key].parts // 1, $m.total] | max) |
			.[$key].indexes = (((.[$key].indexes // []) + $m.indexes) | unique_by(tonumber) | sort_by(tonumber)) |
			.[$key].content[(($m.part | tostring))] = $m.content |
			.[$key].received[(($m.part | tostring))] = true
		) |
		to_entries |
		map(.value) |
		map(. + {
			received_count: ((.received // {}) | keys | length),
			complete: (((.received // {}) | keys | length) >= (.parts // 1)),
			index: ((.indexes // []) | join(",")),
			body: ([range(1; ((.parts // 1) + 1)) as $i | (.content[($i|tostring)] // "")] | join(""))
		}) |
		sort_by((.indexes[-1] // 0) | tonumber) |
		reverse[]' "$raw_file"
}

scan_once() {
	local raw_file title content key complete indexes sender timestamp body hash count pushed skipped

	sms_cfg
	[ "$FORWARD_ENABLE" = "1" ] || { log_msg "INFO disabled"; return 0; }
	require_cmd jq || return 1
	require_cmd curl || return 1
	require_cmd "$SMS_TOOL_BIN" || return 1

	mkdir -p "$STATE_DIR"
	raw_file="$(mktemp "$STATE_DIR/raw.XXXXXX")"
	if ! run_sms_tool "$raw_file" "$STATE_DIR/sms_tool.err" -s "$STORAGE" -d "$PORT" -f '%Y-%m-%d %H:%M' -j recv; then
		log_msg "ERROR sms_tool recv failed: $(cat "$STATE_DIR/sms_tool.err" 2>/dev/null)"
		rm -f "$raw_file"
		return 1
	fi

	read_merged_messages "$raw_file" > "$PENDING_FILE" || {
		log_msg "ERROR failed to parse sms json"
		rm -f "$raw_file"
		return 1
	}
	rm -f "$raw_file"

	count=0
	pushed=0
	skipped=0
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		count=$((count + 1))
		complete="$(printf '%s' "$line" | jq -r '.complete')"
		indexes="$(printf '%s' "$line" | jq -r '.index')"
		sender="$(printf '%s' "$line" | jq -r '.sender')"
		timestamp="$(printf '%s' "$line" | jq -r '.timestamp')"
		body="$(printf '%s' "$line" | jq -r '.body')"
		[ -n "$body" ] || body="-"

		if [ "$FORWARD_COMPLETE_ONLY" = "1" ] && [ "$complete" != "true" ]; then
			skipped=$((skipped + 1))
			log_msg "INFO wait incomplete sms sender=$sender time=$timestamp indexes=$indexes"
			continue
		fi

		hash="$(printf '%s' "${sender}|${timestamp}|${indexes}|${body}" | sha256sum | awk '{print $1}')"
		key="${STORAGE}|${sender}|${timestamp}|${indexes}|${hash}"
		if already_sent "$key"; then
			skipped=$((skipped + 1))
			continue
		fi

		title="CPE 收到短信"
		content="发件人：${sender}
时间：${timestamp}
索引：${indexes}

${body}"
		if push_message "$title" "$content"; then
			mark_sent "$key"
			delete_indexes "$indexes"
			pushed=$((pushed + 1))
			log_msg "INFO forwarded sms sender=$sender time=$timestamp indexes=$indexes"
		else
			log_msg "ERROR push failed sender=$sender time=$timestamp indexes=$indexes"
			return 1
		fi
	done < "$PENDING_FILE"

	log_msg "INFO scan done total=$count pushed=$pushed skipped=$skipped"
}

run_loop() {
	local interval

	sms_cfg
	interval="$(uci_get sms_tool.general.forward_interval 30)"
	case "$interval" in
		''|*[!0-9]*) interval=30 ;;
	esac
	[ "$interval" -ge 10 ] || interval=10

	log_msg "INFO service started interval=${interval}s"
	while :; do
		scan_once
		sleep "$interval"
	done
}

test_push() {
	sms_cfg
	require_cmd jq || { echo "FAILED: missing jq"; return 1; }
	require_cmd curl || { echo "FAILED: missing curl"; return 1; }
	title="CPE 短信转发测试"
	content="这是一条测试通知。时间：$(date '+%Y-%m-%d %H:%M:%S')"
	if push_message "$title" "$content"; then
		log_msg "INFO test push ok"
		echo "OK"
	else
		log_msg "ERROR test push failed"
		echo "FAILED"
		return 1
	fi
}

test_channel() {
	local channel="$1"
	local issue title content

	sms_cfg
	forward_cfg

	if [ -z "$channel" ]; then
		echo "FAILED: 未指定通道"
		return 1
	fi

	issue="$(channel_issue "$channel")"
	if [ "$issue" != "可用" ]; then
		log_msg "ERROR test channel not ready channel=$channel issue=$issue"
		echo "FAILED: $(channel_name "$channel") $issue"
		return 1
	fi

	require_cmd jq || { echo "FAILED: missing jq"; return 1; }
	require_cmd curl || { echo "FAILED: missing curl"; return 1; }

	title="CPE 通道测试"
	content="这是一条测试通知。
通道：$(channel_name "$channel")
时间：$(date '+%Y-%m-%d %H:%M:%S')"
	if push_channel "$channel" "$title" "$content"; then
		log_msg "INFO test channel ok channel=$(channel_name "$channel") id=$channel"
		echo "OK: $(channel_name "$channel") 测试发送成功"
	else
		log_msg "ERROR test channel failed channel=$(channel_name "$channel") id=$channel"
		echo "FAILED: $(channel_name "$channel") 测试发送失败，请检查密钥、代理和网络"
		return 1
	fi
}

channels_json() {
	local channel type enabled ready first issue remark

	first=1
	printf '['
	for channel in $(channel_sections); do
		type="$(channel_type "$channel")"
		if channel_enabled "$channel"; then enabled=true; else enabled=false; fi
		if channel_ready "$channel"; then ready=true; else ready=false; fi
		issue="$(channel_issue "$channel")"
		remark="$(channel_get "$channel" remark '')"

		[ "$first" = "1" ] || printf ','
		first=0
		printf '{'
		printf '"id":"%s",' "$(json_escape "$channel")"
		printf '"name":"%s",' "$(channel_name "$channel" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		printf '"type":"%s",' "$(json_escape "$type")"
		printf '"enabled":%s,' "$enabled"
		printf '"ready":%s,' "$ready"
		printf '"issue":"%s",' "$(json_escape "$issue")"
		printf '"remark":"%s"' "$(json_escape "$remark")"
		printf '}'
	done
	printf ']\n'
}

status_json() {
	local last_line running enabled interval retry_count retry_delay
	local channel channel_count enabled_count ready_count missing_deps

	sms_cfg
	missing_deps="$(missing_runtime_deps)"
	enabled="$FORWARD_ENABLE"
	interval="$(uci_get sms_tool.general.forward_interval 30)"
	case "$interval" in
		''|*[!0-9]*) interval=30 ;;
	esac
	retry_count="$FORWARD_RETRY_COUNT"
	case "$retry_count" in
		''|*[!0-9]*) retry_count=1 ;;
	esac
	retry_delay="$FORWARD_RETRY_DELAY"
	case "$retry_delay" in
		''|*[!0-9]*) retry_delay=3 ;;
	esac
	last_line="$(tail -n 1 "$LOG_FILE" 2>/dev/null)"
	if ps | grep -F '/usr/bin/c8-sms-forward run' | grep -v grep >/dev/null 2>&1; then
		running=1
	else
		running=0
	fi
	channel_count=0
	enabled_count=0
	ready_count=0
	for channel in $(channel_sections); do
		channel_count=$((channel_count + 1))
		channel_enabled "$channel" && enabled_count=$((enabled_count + 1))
		channel_ready "$channel" && ready_count=$((ready_count + 1))
	done
	printf '{'
	printf '"enabled":%s,' "$([ "$enabled" = "1" ] && echo true || echo false)"
	printf '"running":%s,' "$([ "$running" = "1" ] && echo true || echo false)"
	printf '"interval":%s,' "$interval"
	printf '"storage":"%s",' "$(printf '%s' "$STORAGE" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"port":"%s",' "$(printf '%s' "$PORT" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"deps_ready":%s,' "$([ -z "$missing_deps" ] && echo true || echo false)"
	printf '"missing_deps":"%s",' "$(printf '%s' "$missing_deps" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"channel_count":%s,' "$channel_count"
	printf '"enabled_channel_count":%s,' "$enabled_count"
	printf '"ready_channel_count":%s,' "$ready_count"
	printf '"primary_channel":"%s",' "$(printf '%s' "$FORWARD_PRIMARY_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"primary_name":"%s",' "$(channel_name "$FORWARD_PRIMARY_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"primary_ready":%s,' "$(channel_ready "$FORWARD_PRIMARY_CHANNEL" && echo true || echo false)"
	printf '"primary_issue":"%s",' "$(channel_issue "$FORWARD_PRIMARY_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"backup_enabled":%s,' "$([ "$FORWARD_BACKUP_ENABLE" = "1" ] && echo true || echo false)"
	printf '"backup_channel":"%s",' "$(printf '%s' "$FORWARD_BACKUP_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"backup_name":"%s",' "$(channel_name "$FORWARD_BACKUP_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"backup_ready":%s,' "$(channel_ready "$FORWARD_BACKUP_CHANNEL" && echo true || echo false)"
	printf '"backup_issue":"%s",' "$(channel_issue "$FORWARD_BACKUP_CHANNEL" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '"retry_count":%s,' "$retry_count"
	printf '"retry_delay":%s,' "$retry_delay"
	printf '"sms_tool_timeout":%s,' "$SMS_TOOL_TIMEOUT"
	printf '"last":"%s"' "$(printf '%s' "$last_line" | sed 's/\\/\\\\/g; s/"/\\"/g')"
	printf '}\n'
}

show_log() {
	tail -n 120 "$LOG_FILE" 2>/dev/null || true
}

clear_log() {
	mkdir -p "$STATE_DIR"
	: > "$LOG_FILE"
	log_msg "INFO log cleared"
}

case "$1" in
	run) run_loop ;;
	once|'') scan_once ;;
	test) test_push ;;
	test-channel) test_channel "$2" ;;
	status) status_json ;;
	channels) channels_json ;;
	log) show_log ;;
	clear-log) clear_log ;;
	*) echo "Usage: $0 {run|once|test|test-channel <id>|status|channels|log|clear-log}" >&2; exit 1 ;;
esac
