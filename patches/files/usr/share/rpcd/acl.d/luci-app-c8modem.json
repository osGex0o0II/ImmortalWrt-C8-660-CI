{
	"luci-app-c8modem": {
		"description": "Grant access to C8 modem status, settings and AT commands",
		"read": {
			"file": {
				"/usr/share/modem/zinfo.sh": [ "exec" ],
				"/usr/bin/cellscan.sh status": [ "exec" ],
				"/usr/bin/c8-sms-forward *": [ "exec" ],
				"/usr/bin/sms_tool *": [ "exec" ],
				"/tmp/cpe_cell.file": [ "read" ],
				"/tmp/cellscan.json": [ "read" ],
				"/tmp/cellinfo": [ "read" ],
				"/tmp/c8-sms-forward.log": [ "read" ],
				"/tmp/simcardstat": [ "read" ],
				"/tmp/ipv6prefix": [ "read" ],
				"/tmp/result.at": [ "read" ],
				"/usr/bin/adb devices": [ "exec" ],
				"/usr/bin/adb shell uptime": [ "exec" ],
				"/sbin/ifstatus wan6": [ "exec" ],
				"/bin/sendat 2 AT+CGSN": [ "exec" ],
				"/bin/sendat 2 AT+QADBKEY?": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ]
			},
			"uci": [ "modem", "sms_tool" ]
		},
		"write": {
			"file": {
				"/usr/share/modem/atcmd.sh *": [ "exec" ],
				"/usr/share/modem/delatcmd.sh": [ "exec" ],
				"/usr/share/modem/luci-reinit.sh": [ "exec" ],
				"/etc/init.d/c8-sms-forward *": [ "exec" ],
				"/usr/bin/cellscan.sh start": [ "exec" ],
				"/usr/bin/cellscan.sh stop": [ "exec" ],
				"/usr/bin/c8-sms-forward *": [ "exec" ],
				"/usr/bin/sms_tool *": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "write" ]
			},
			"uci": [ "modem", "sms_tool" ]
		}
	}
}
