{
	"luci-app-c8modem": {
		"description": "Grant access to C8 modem status, settings and AT commands",
		"read": {
			"file": {
				"/usr/share/modem/zinfo.sh": [ "exec" ],
				"/usr/share/modem/atcmd.sh *": [ "exec" ],
				"/usr/share/modem/delatcmd.sh": [ "exec" ],
				"/usr/bin/cellscan.sh *": [ "exec" ],
				"/usr/bin/sms_tool *": [ "exec" ],
				"/usr/bin/iwinfo *": [ "exec" ],
				"/tmp/cpe_cell.file": [ "read" ],
				"/tmp/cellscan.json": [ "read" ],
				"/tmp/cellinfo": [ "read" ],
				"/tmp/simcardstat": [ "read" ],
				"/tmp/ipv6prefix": [ "read" ],
				"/tmp/result.at": [ "read" ],
				"/usr/bin/adb devices": [ "exec" ],
				"/usr/bin/adb shell uptime": [ "exec" ],
				"/bin/sendat 2 *": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ]
			},
			"uci": [ "modem", "sms_tool" ]
		},
		"write": {
			"file": {
				"/usr/share/modem/rm520n.sh": [ "exec" ],
				"/usr/share/modem/atcmd.sh *": [ "exec" ],
				"/usr/share/modem/delatcmd.sh": [ "exec" ],
				"/usr/share/modem/luci-reinit.sh": [ "exec" ],
				"/usr/bin/cellscan.sh *": [ "exec" ],
				"/usr/bin/sms_tool *": [ "exec" ],
				"/tmp/freq.run": [ "write" ]
			},
			"ubus": {
				"file": [ "exec", "write" ]
			},
			"uci": [ "modem", "sms_tool" ]
		}
	}
}
