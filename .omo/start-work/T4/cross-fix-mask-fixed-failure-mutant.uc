const UNKNOWN_METHOD = 'UNKNOWN_METHOD';
const UNKNOWN_FIELD = 'UNKNOWN_FIELD';

function request_args(request) { if (type(request) != 'object' || type(request.args) != 'object') return {}; return request.args; }
function failure_result(error_code, failures) { const failure = failures[error_code] || failures.INTERNAL_ERROR; return { ok: false, state: string(failure.state), stage: string(failure.stage), error_code: string(failure.error_code), message: string(failure.message), details: {} }; }
function validate_request(args, schema, unknown_field) { for (const key in args) { if (!(key in schema)) return { ok: false, error_code: string(unknown_field.error_code), channel: '' }; } if ('channel' in schema && (type(args.channel) != schema.channel.type || !match(args.channel, schema.channel.pattern))) return { ok: false, error_code: 'INVALID_CHANNEL', channel: '' }; return { ok: true, error_code: '', channel: 'channel' in schema ? args.channel : '' }; }
function build_argv(fixed, channel) { const argv = []; for (let i = 0; i < length(fixed); i++) push(argv, fixed[i] == '$channel' ? channel : fixed[i]); return argv; }
function run_backend(executable, argv) { if (executable != RPC_CONTRACT.executable || argv[0] != executable) return { ok: false, error_code: 'INVALID_EXECUTABLE', exit: 0, stdout: '', stderr: '' }; let command = ''; for (let i = 0; i < length(argv); i++) { const argument = argv[i]; if (!match(argument, '^[A-Za-z0-9_./-]+$')) return { ok: false, error_code: 'INVALID_ARGUMENT', exit: 0, stdout: '', stderr: '' }; command += (i ? ' ' : '') + argument; } const process = popen(command, 'r'); if (!process) return { ok: false, error_code: 'BACKEND_OPEN_FAILED', exit: 0, stdout: '', stderr: '' }; const stdout = process.read('all'); const exit = process.close(); return { ok: true, error_code: '', exit: exit, stdout: string(stdout || ''), stderr: '' }; }
function map_backend_exit(exit, stdout, stderr, exit_map) { const entry = exit_map[string(exit)]; if (!entry) return failure_result('UNMAPPED_EXIT', RPC_CONTRACT.failure_map); return { ok: exit == 0, state: string(entry.state), stage: string(entry.stage), error_code: string(entry.error_code), message: string(stderr || stdout || ''), details: { stdout: string(stdout || ''), stderr: string(stderr || '') } }; }
function mask_value(value, masking) { const kind = type(value); if (kind == 'string') return masking.replacement; if (kind == 'array') { const masked = []; for (const index in value) push(masked, mask_value(value[index], masking)); return masked; } if (kind == 'object') { const masked = {}; for (const key in value) masked[key] = mask_value(value[key], masking); return masked; } return value; }
function mask_result(result, masking) { if (!masking.recursive) return failure_result('INVALID_MASKING', RPC_CONTRACT.failure_map); const message = mask_value(result.message, masking); const details = mask_value(result.details, masking); return { ok: result.ok, state: result.state, stage: result.stage, error_code: result.error_code, message: message, details: details }; }

function safe_pipeline(method, args) {
	const spec = RPC_CONTRACT.methods[method];
	const validated = validate_request(args, spec.request, RPC_CONTRACT.unknown_field);
	if (!validated.ok) return failure_result(validated.error_code, RPC_CONTRACT.failure_map);
	const argv = build_argv(spec.argv, validated.channel);
	const backend = run_backend('/usr/bin/c8-sms-forward', argv);
	if (!backend.ok) return failure_result(backend.error_code, RPC_CONTRACT.failure_map);
	const mapped = map_backend_exit(backend.exit, backend.stdout, backend.stderr, RPC_CONTRACT.exit_map);
	const masked = mask_result(mapped, RPC_CONTRACT.masking);
	return masked;
}

const methods = {
	status: { call: function(request) { return safe_pipeline('status', request_args(request)); } },
	preflight: { call: function(request) { return safe_pipeline('preflight', request_args(request)); } },
